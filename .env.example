ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# anthropic or openai
BVS_PROVIDER=anthropic
DOCS_ROOT=./examples/corpus

CLAUDE_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-5

# Optional cheaper model for search sub-agents.
# BVS_SEARCH_MODEL=

# Optional hard stop on input tokens (uncached + cached) for one question.
# BVS_MAX_INPUT_TOKENS=200000

# BVS_MAX_TURNS=25
# BVS_CHROMA_PATH=.chroma
